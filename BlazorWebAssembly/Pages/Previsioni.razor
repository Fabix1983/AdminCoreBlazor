@page "/previsioni"
@using System.ComponentModel.DataAnnotations;
@using ChartJs.Blazor.BarChart
@using Shared.Class
@inject NavigationManager Navigation
@using System.Net.Http
@inject HttpClient Http
@inject StateMenagement StateMenagement
@inject IJSRuntime JsRuntime

<PageTitle>Previsioni</PageTitle>

<h1><i class="bi bi-crop"></i> Previsioni di Spesa</h1>
<hr />

<div class="container-fluid">
    <div class="row">
        @if (previsioneTotaleListaOUT.Status == null)
        {
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(genericOUT.StatusError))
            {
                <div class="row">
                    <div class="col-md-12">
                        <div class="alert @(genericOUT.Status == "OK" ? "alert-success" : "alert-danger")" role="alert">
                            <p><b>@genericOUT.StatusError</b>&nbsp;&nbsp;<button type="button" class="btn btn-outline-@(genericOUT.Status == "OK" ? "success" : "danger") btn-sm" @onclick="(e => refreshdel())"><i class="bi bi-x-lg"></i></button></p>
                        </div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(previsioneTotaleListaOUT.StatusError))
            {
                <div class="col-md-12">
                    <div class="alert alert-warning" role="alert">
                        <p><b>@previsioneTotaleListaOUT.StatusError</b></p>
                    </div>
                </div>
            }

            <div class="col-md-3">
                <div class="alert alert-primary" role="alert">
                    <div class="box-body">
                        <p><b>Riepilogo Previsione di spesa</b></p>
                        <p>Previsioni di Spesa Nr.:<b>@numattivita</b></p>
                        <p>Totale Previsioni di Spesa: <b>@totale &euro;</b></p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="alert alert-secondary" role="alert">
                    <div class="box-body">
                        <p><b>Aggregati Previsione di spesa</b></p>
                        <table class="table table-striped">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Tipologia</th>
                                    <th>Valore</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var previsione in previsioneTotaleAggregatiListaOUT.Previsione)
                                {
                                    <tr>
                                        <td><b><font color="@previsione.ColoreHTML.ToString()">@previsione.TipoAttivita.ToString()</font></b></td>
                                        @if (Math.Round((decimal)previsione.Costo, 0) < 0)
                                        {
                                            <td><font color="red">@Math.Round((decimal)previsione.Costo, 0)</font></td>
                                        }
                                        else
                                        {
                                            <td><font color="green">@Math.Round((decimal)previsione.Costo, 0)</font></td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="box-body">
                    <div class="alert alert-warning" role="alert">
                        <p><b>Nuova Previsione di spesa</b></p>
                        <EditForm Model="@modelPre" OnValidSubmit="OnValidSubmitPre">
                            <DataAnnotationsValidator />
                            <div class="row">
                                <div class="col-md-3">
                                    <label>
                                        Periodo:
                                        <InputSelect @bind-Value="modelPre.RifPeriodo" class="form-select">
                                            <option value="0">Periodo...</option>
                                            @foreach (var dept in listaperiodiOUT.Periodo)
                                            {
                                                <option value="@dept.ID">@dept.Descrizione</option>
                                            }
                                        </InputSelect>
                                    </label>
                                </div>
                                <div class="col-md-2">
                                    <label>
                                        Giorno:
                                        <InputNumber @bind-Value="modelPre.Giorno" class="form-control" style="width: 4em" Min="1" Max="@ultimogiornodelmese" />
                                    </label>
                                </div>
                                <div class="col-md-5">
                                    <label>
                                        Dettagli:
                                        <InputText @bind-Value="modelPre.Descrizione" class="form-control" />
                                    </label>
                                </div>
                                <div class="col-md-2">
                                    <label>
                                        Importo &euro;:
                                        <InputNumber @bind-Value="modelPre.Costo" class="form-control" style="width: 6em" Min="1" />
                                    </label>
                                </div>
                                <div class="col-md-6">
                                    <label>
                                        Tipo Attivita:
                                        <InputSelect @bind-Value="modelPre.RifTipoAttivita" class="form-select">
                                            <option value="0">Seleziona una tipologia</option>
                                            @foreach (var dept in tipoattOUT.TipoAttivita)
                                            {
                                                <option value="@dept.ID">@dept.Tipo</option>
                                            }
                                        </InputSelect>
                                    </label>
                                </div>
                                <div class="col-md-3">
                                    <label>
                                        Auto:
                                        <InputSelect @bind-Value="modelPre.AddebitoAutomatico" class="form-select">
                                            <option value="0">NO</option>
                                            <option value="1">SI</option>
                                        </InputSelect>
                                    </label>
                                </div>
                                <div class="col-md-3">
                                    <br><button type="submit" class="btn btn-warning">Procedi</button>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>

            <hr />

            @if (previsioneTotaleListaOUT.Previsione != null)
            {
                <div class="col-md-8">
                    <div class="box-body">
                        <table class="table table-striped">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Giorno</th>
                                    <th>Periodo</th>
                                    <th>Descrizione</th>
                                    <th>Tipo Costo</th>
                                    <th>Costo</th>
                                    <th>Auto</th>
                                    <th>Azione</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var previsione in previsioneTotaleListaOUT.Previsione)
                                {
                                    <tr>
                                        <td>@previsione.Giorno.ToString()</td>
                                        <td>@previsione.DescrizionePeriodo.ToString()</td>
                                        <td>@previsione.Descrizione.ToString()</td>
                                        <td><b><font color="@previsione.ColoreHTML.ToString()">@previsione.TipoAttivita.ToString()</font></b></td>
                                        <td>@Math.Round((decimal)@previsione.Costo, 0)&nbsp;&euro;</td>
                                        <td>@(Convert.ToInt32(previsione.AddebitoAutomatico) == 1 ? "SI" : "NO")</td>
                                        <td><button type="button" class="btn btn-outline-primary btn-sm" @onclick="(e => deletePrev(previsione.ID))"><i class="bi bi-x-lg"></i></button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="alert alert-secondary" role="alert">
                        <p><b>Distribuzione Previsioni di Spesa</b></p>
                        @if (_configBar != null)
                        {
                            <Chart Config="_configBar"></Chart>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="col-md-12">
                    <div class="alert alert-primary" role="alert">
                        <p><b>Non sono presenti Previsioni di Spese future.</b></p>
                    </div>
                </div>
            }
        }
    </div>
</div>
<hr />
<Bottom></Bottom>

@code {
    private PrevisioneTotaleListaOUT previsioneTotaleListaOUT { get; set; } = new();
    public HttpClient httpClient = new();
    public decimal? totale { get; set; } = 0;
    public int? numattivita { get; set; } = 0;
    public GenericOUT genericOUT = new();
    private PrevisioneIN modelPre { get; set; } = new();
    public ListaPeriodiOUT listaperiodiOUT = new();
    public TipoAttivitaOUT tipoattOUT = new();
    public PrevisioneTotaleAggregatiListaOUT previsioneTotaleAggregatiListaOUT = new();
    public int ultimogiornodelmese { get; set; }
    public BarConfig _configBar;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var anno = DateTime.Now.Year;
            var mese = DateTime.Now.Month;
            ultimogiornodelmese = DateTime.DaysInMonth(anno, mese);
            modelPre.Giorno = DateTime.Now.Day;

            // Caricamento Dati
            await CaricaDatiAPI();

            // Configurazione Grafico
            InizializzaGrafico();

            // Popolamento Dati Grafico
            AggiornaDatiGrafico();
        }
        catch (Exception e)
        {
            Navigation.NavigateTo("/errore?errdesc=" + e.ToString());
        }
    }

    private async Task CaricaDatiAPI()
    {
        httpClient.DefaultRequestHeaders.Clear();
        httpClient.DefaultRequestHeaders.Add("Accept", "application/json");

        var response = await httpClient.GetStringAsync(StateMenagement.api_url + "/api/Previsioni/ListaTotale");
        previsioneTotaleListaOUT = System.Text.Json.JsonSerializer.Deserialize<PrevisioneTotaleListaOUT>(StateMenagement.JsonNormalized(response));
        totale = previsioneTotaleListaOUT.Previsione.Sum(item => Convert.ToDecimal(item.Costo));
        numattivita = previsioneTotaleListaOUT.Previsione.Count();

        response = await httpClient.GetStringAsync(StateMenagement.api_url + "/api/Previsioni/ListaTotaleAggregata");
        previsioneTotaleAggregatiListaOUT = System.Text.Json.JsonSerializer.Deserialize<PrevisioneTotaleAggregatiListaOUT>(StateMenagement.JsonNormalized(response));

        response = await httpClient.GetStringAsync(StateMenagement.api_url + "/api/Previsioni/ListaPeriodi");
        listaperiodiOUT = System.Text.Json.JsonSerializer.Deserialize<ListaPeriodiOUT>(StateMenagement.JsonNormalized(response));

        response = await httpClient.GetStringAsync(StateMenagement.api_url + "/api/Attivita/TipoAttivitaList");
        tipoattOUT = System.Text.Json.JsonSerializer.Deserialize<TipoAttivitaOUT>(StateMenagement.JsonNormalized(response));
    }

    private void InizializzaGrafico()
    {
        if (_configBar == null)
        {
            _configBar = new BarConfig
            {
                Options = new BarOptions
                {
                    Responsive = true,
                    Legend = new Legend { Display = false },
                    Title = new OptionsTitle { Display = false }
                }
            };
        }
    }

    private void AggiornaDatiGrafico()
    {
        if (previsioneTotaleAggregatiListaOUT?.Previsione == null) return;

        _configBar.Data.Labels.Clear();
        _configBar.Data.Datasets.Clear();

        var dataset = new BarDataset<int>();
        var colors = new List<string>();

        foreach (var item in previsioneTotaleAggregatiListaOUT.Previsione)
        {
            decimal costo = (decimal)item.Costo;
            if (Math.Round(costo, 0) < 0)
            {
                _configBar.Data.Labels.Add(item.TipoAttivita.ToString());
                dataset.Add(Convert.ToInt32(costo) * -1);
                colors.Add(item.ColoreHTML.ToString());
            }
        }

        if (dataset.Count > 0)
        {
            dataset.BackgroundColor = colors.ToArray();
            _configBar.Data.Datasets.Add(dataset);
        }
    }

    private async Task deletePrev(int id)
    {
        bool confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "Vuoi eliminare la voce?");
        if (confirmed)
        {
            await httpClient.DeleteAsync(StateMenagement.api_url + "/api/Previsioni/Delete/" + id);
            await OnInitializedAsync();
            StateHasChanged();
        }
    }

    private async Task refreshdel()
    {
        genericOUT.Status = null;
        genericOUT.StatusError = null;
        await OnInitializedAsync();
    }

    private async Task OnValidSubmitPre()
    {
        if (modelPre.RifPeriodo == 0 || modelPre.RifTipoAttivita == 0 || string.IsNullOrEmpty(modelPre.Descrizione))
        {
            genericOUT.Status = "KO";
            genericOUT.StatusError = "Dati obbligatori mancanti!";
            return;
        }

        var json = System.Text.Json.JsonSerializer.Serialize(modelPre);
        var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
        var response = await httpClient.PostAsync(StateMenagement.api_url + "/api/Previsioni/New", content);

        if (response.IsSuccessStatusCode)
        {
            genericOUT.Status = "OK";
            genericOUT.StatusError = "Inserimento eseguito correttamente";
            modelPre = new PrevisioneIN { Giorno = DateTime.Now.Day };
            await OnInitializedAsync();
        }
    }
}